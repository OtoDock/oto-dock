 "info": {
  "description": "Use your OtoDock from outside with a personal API key: your agents, chats, tasks, files and notifications. A key acts as you, on the agents it names, with the permissions you gave it, and never does more than you can. Make a key in your settings. Send it as `Authorization: Bearer otok_...`.",
  "title": "OtoDock API",
  "version": "1.0"
 },
 "openapi": "3.1.0",
 "paths": {
  "/v1/api/agents": {
   "get": {
    "description": "The agents the key reaches, with the person's role on each.",
    "operationId": "agents_v1_api_agents_get",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/AgentsAnswer"
        }
       }
      },
      "description": "Successful Response"
     }
    },
    "summary": "Agents",
    "tags": [
     "key"
    ]
   }
  },
  "/v1/api/agents/{agent}/files": {
   "get": {
    "description": "The agent's files the key reaches, as a tree.",
    "operationId": "tree_v1_api_agents__agent__files_get",
    "parameters": [
     {
      "in": "path",
      "name": "agent",
      "required": true,
      "schema": {
       "title": "Agent",
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Tree"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Tree",
    "tags": [
     "files"
    ]
   }
  },
  "/v1/api/agents/{agent}/files/{path}": {
   "get": {
    "description": "A file's content: text as JSON, or the bytes with ``download``.",
    "operationId": "read_file_v1_api_agents__agent__files__path__get",
    "parameters": [
     {
      "in": "path",
      "name": "agent",
      "required": true,
      "schema": {
       "title": "Agent",
       "type": "string"
      }
     },
     {
      "in": "path",
      "name": "path",
      "required": true,
      "schema": {
       "title": "Path",
       "type": "string"
      }
     },
     {
      "in": "query",
      "name": "download",
      "required": false,
      "schema": {
       "default": false,
       "title": "Download",
       "type": "boolean"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {}
       }
      },
      "description": "The file: JSON with its text, or its bytes"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Read File",
    "tags": [
     "files"
    ]
   },
   "put": {
    "description": "Write a text file in your own folder or the workspace.",
