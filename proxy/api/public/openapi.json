  "/v1/api/chats/{chat_id}/messages": {
   "post": {
    "description": "Send a message as the person and wait, at most ``wait_seconds``, for\nthe end of its turn. A key not made to run without asking sends only\ninto a chat in Ask or Plan. A turn that needs approval waits for the\nperson in the dashboard. Past the bound the answer says the turn still runs; read\nit with ``GET /v1/api/chats/{chat_id}/messages/{message_id}``. While\nOtoDock cannot take it (it is updating, or its compute machine is not\nconnected) the answer is 503 with ``Retry-After``: send the request\nagain with the same ``request_id``.",
    "operationId": "send_message_v1_api_chats__chat_id__messages_post",
    "parameters": [
     {
      "in": "path",
      "name": "chat_id",
      "required": true,
      "schema": {
       "title": "Chat Id",
       "type": "string"
      }
     }
    ],
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/Send"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/TurnAnswer"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     },
     "503": {
      "description": "OtoDock cannot take it now (it is starting, it is updating or its compute machine is not connected): nothing was sent. Send the same request again after Retry-After"
     }
    },
    "summary": "Send Message",
    "tags": [
     "chat"
    ]
   }
