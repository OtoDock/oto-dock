<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- The bars start on the boot field with light icons: the splash window
         and the activity window agree while the splash fades, and the splash
         library re-applies this theme's bar state when the splash view is
         removed (MainActivity puts the page's own state back after it). Below
         Android 15 the navigation bar is drawn in its window colour under the
         field's bottom, so it takes the field's deep end. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:statusBarColor">@color/bootField</item>
        <item name="android:navigationBarColor">@color/bootFieldDeep</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- The system splash: the mark's white silhouette on the boot field, no
         icon background, so every level draws the icon at 288 dp (the mark
         127 dp wide), which the page's boot screen matches. A launch from a
         notification, or into the running task, prefers the icon over a flat
         field (Android 13 and later honour it). -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bootField</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenBehavior" tools:targetApi="33">icon_preferred</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:statusBarColor">@color/bootField</item>
        <item name="android:navigationBarColor">@color/bootField</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
