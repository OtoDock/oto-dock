<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The shape of the Firebase client config, for push. The official builds
	     carry the OtoDock Firebase project's file; a build against your own
	     project takes the one the Firebase console gives for the iOS app
	     with the bundle id your build uses, saved beside this file as
	     GoogleService-Info.plist (git-ignored). Without it the app runs
	     without push notifications. -->
	<key>API_KEY</key>
	<string>your-ios-api-key</string>
	<key>GCM_SENDER_ID</key>
	<string>000000000000</string>
	<key>PLIST_VERSION</key>
	<string>1</string>
	<key>BUNDLE_ID</key>
	<string>com.otodock</string>
	<key>PROJECT_ID</key>
	<string>your-firebase-project</string>
	<key>STORAGE_BUCKET</key>
	<string>your-firebase-project.appspot.com</string>
	<key>IS_ADS_ENABLED</key>
	<false/>
	<key>IS_ANALYTICS_ENABLED</key>
	<false/>
	<key>IS_APPINVITE_ENABLED</key>
	<false/>
	<key>IS_GCM_ENABLED</key>
	<true/>
	<key>IS_SIGNIN_ENABLED</key>
	<false/>
	<key>GOOGLE_APP_ID</key>
	<string>1:000000000000:ios:0000000000000000</string>
</dict>
</plist>
