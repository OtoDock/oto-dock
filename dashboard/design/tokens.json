  "radius": {
    "$type": "dimension",
    "$description": "Tailwind's default scale: controls md, cards lg, dialogs and popovers xl, hero surfaces 2xl, full for avatars, dots and chips.",
    "none": {"$value": "0px"},
    "sm": {"$value": "4px"},
    "md": {"$value": "6px"},
    "lg": {"$value": "8px"},
    "xl": {"$value": "12px"},
    "2xl": {"$value": "16px"},
    "full": {"$value": "9999px"}
  },
  "spacing": {
    "$type": "dimension",
    "$description": "Spacing runs on a 4 px unit (Tailwind's own --spacing).",
    "unit": {"$value": "4px"}
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {"$value": ["Manrope", "ui-sans-serif", "system-ui", "-apple-system", "Segoe UI", "sans-serif"], "$description": "Every interface string."},
      "display": {"$value": ["Comfortaa", "Manrope", "ui-rounded", "system-ui", "sans-serif"], "$description": "The wordmark, page titles and headings at text-lg and larger, never at label sizes."},
      "mono": {"$value": ["JetBrains Mono", "ui-monospace", "SF Mono", "Menlo", "Consolas", "monospace"], "$description": "Code and the terminal."}
    },
    "size": {
      "$type": "dimension",
      "$description": "The type scale. Each size carries its line height.",
      "3xs": {"$value": "10px", "$extensions": {"io.otodock.lineHeight": "14px"}},
      "2xs": {"$value": "11px", "$extensions": {"io.otodock.lineHeight": "16px"}},
      "xs": {"$value": "12px", "$extensions": {"io.otodock.lineHeight": "16px"}},
      "sm": {"$value": "14px", "$extensions": {"io.otodock.lineHeight": "20px"}},
      "base": {"$value": "16px", "$extensions": {"io.otodock.lineHeight": "24px"}},
      "lg": {"$value": "18px", "$extensions": {"io.otodock.lineHeight": "28px"}},
      "xl": {"$value": "20px", "$extensions": {"io.otodock.lineHeight": "28px"}},
      "2xl": {"$value": "24px", "$extensions": {"io.otodock.lineHeight": "32px"}},
      "3xl": {"$value": "28px", "$extensions": {"io.otodock.lineHeight": "36px"}}
    }
  },
  "duration": {
    "$type": "duration",
    "fast": {"$value": "120ms", "$description": "Hovers, presses, small fades."},
    "base": {"$value": "200ms", "$description": "Panels, switches, popovers."},
    "slow": {"$value": "320ms", "$description": "Dialogs, sheets, page-level motion."}
  },
  "easing": {
    "$type": "cubicBezier",
    "standard": {"$value": [0.2, 0, 0, 1], "$description": "Most motion."},
    "enter": {"$value": [0, 0, 0, 1], "$description": "Something arriving."},
    "exit": {"$value": [0.3, 0, 1, 1], "$description": "Something leaving."}
  },
  "surface": {
    "$type": "color",
    "$description": "Depth comes from surface steps and elevation. A border is the exception.",
    "page": {"$value": "{color.warm.50}", "$extensions": {"io.otodock.modes": {"dark": "{color.ink.900}"}}, "$description": "The page behind everything."},
    "card": {"$value": "{color.warm.0}", "$extensions": {"io.otodock.modes": {"dark": "{color.ink.800}"}}, "$description": "Cards and panels on the page."},
    "raised": {"$value": "{color.warm.0}", "$extensions": {"io.otodock.modes": {"dark": "{color.ink.700}"}}, "$description": "Something lifted inside a card: a selected row, a nested panel."},
    "overlay": {"$value": "{color.warm.0}", "$extensions": {"io.otodock.modes": {"dark": "{color.ink.600}"}}, "$description": "Popovers, menus, dialogs, toasts."},
    "sunken": {"$value": "{color.warm.100}", "$extensions": {"io.otodock.modes": {"dark": "{color.ink.950}"}}, "$description": "Inset wells: a code area, a drop zone."},
    "muted": {"$value": "{color.warm.150}", "$extensions": {"io.otodock.modes": {"dark": "{color.ink.700}"}}, "$description": "A neutral fill: chips, neutral badges, a quiet button."},
    "hover": {"$value": "#0000000d", "$extensions": {"io.otodock.modes": {"dark": "#ffffff12"}}, "$description": "The hover of a row or a quiet control, on any surface. Light: black at 5 percent. Dark: white at 7 percent."},
    "scrim": {"$value": "#00000066", "$extensions": {"io.otodock.modes": {"dark": "#0000008c"}}, "$description": "Behind a dialog or a sheet. Light: black at 40 percent. Dark: black at 55 percent."},
    "chrome": {"$value": "{color.warm.0}", "$extensions": {"io.otodock.modes": {"dark": "{color.navy.850}"}}, "$description": "The chat chrome when it is opaque (its glass is glass.fill)."},
    "inverse": {"$value": "{color.slate.900}", "$extensions": {"io.otodock.modes": {"dark": "{color.ink.50}"}}, "$description": "Tooltips."}
  },
  "text": {
    "$type": "color",
    "primary": {"$value": "{color.slate.900}", "$extensions": {"io.otodock.modes": {"dark": "{color.ink.50}"}}},
    "secondary": {"$value": "{color.slate.700}", "$extensions": {"io.otodock.modes": {"dark": "{color.ink.200}"}}},
    "tertiary": {"$value": "{color.slate.600}", "$extensions": {"io.otodock.modes": {"dark": "{color.ink.300}"}}, "$description": "Meta text, timestamps, placeholders. Still AA on every surface."},
    "inverse": {"$value": "{color.warm.50}", "$extensions": {"io.otodock.modes": {"dark": "{color.ink.900}"}}, "$description": "Text on surface.inverse."},
    "link": {"$value": "{color.blue.600}", "$extensions": {"io.otodock.modes": {"dark": "{color.blue.400}"}}},
    "link-hover": {"$value": "{color.blue.700}", "$extensions": {"io.otodock.modes": {"dark": "{color.blue.300}"}}, "$description": "A link under the pointer."},
    "on-solid": {"$value": "{color.white}", "$extensions": {"io.otodock.modes": {"dark": "{color.white}"}}, "$description": "Text and icons on a solid or fill colour (status.*.fill, accent.agent.fill, a solid badge)."}
  },
  "border": {
    "$type": "color",
    "$description": "Borders are the exception: use them for inputs, tables and dividers, not to separate a card from the page.",
    "subtle": {"$value": "{color.warm.200}", "$extensions": {"io.otodock.modes": {"dark": "#ffffff0f"}}, "$description": "Dark: white at 6 percent."},
    "default": {"$value": "{color.warm.300}", "$extensions": {"io.otodock.modes": {"dark": "#ffffff1a"}}, "$description": "Dark: white at 10 percent."},
    "strong": {"$value": "{color.warm.500}", "$extensions": {"io.otodock.modes": {"dark": "#ffffff5c"}}, "$description": "Input boundaries at 3:1. Dark: white at 36 percent."}
  },
  "action": {
    "$type": "color",
    "$description": "The action blue. The fill is blue.600 in both modes (white on it 5.5:1).",
    "default": {"$value": "{color.blue.600}", "$extensions": {"io.otodock.modes": {"dark": "{color.blue.600}"}}},
    "hover": {"$value": "{color.blue.700}", "$extensions": {"io.otodock.modes": {"dark": "{color.blue.700}"}}},
    "active": {"$value": "{color.blue.900}", "$extensions": {"io.otodock.modes": {"dark": "{color.blue.900}"}}},
    "fg": {"$value": "{color.white}", "$extensions": {"io.otodock.modes": {"dark": "{color.white}"}}, "$description": "Text and icons on an action fill."},
    "subtle": {"$value": "{color.blue.75}", "$extensions": {"io.otodock.modes": {"dark": "{color.navy.700}"}}, "$description": "A selected or brand-tinted surface."},
    "subtle-hover": {"$value": "{color.blue.100}", "$extensions": {"io.otodock.modes": {"dark": "{color.navy.600}"}}}
  },
  "brand": {
    "$type": "color",
    "$description": "The brand colour is the action blue. Navy is a surface colour (hero.*).",
    "default": {"$value": "{action.default}", "$extensions": {"io.otodock.modes": {"dark": "{action.default}"}, "io.otodock.text": "{text.link}"}},
    "hover": {"$value": "{action.hover}", "$extensions": {"io.otodock.modes": {"dark": "{action.hover}"}, "io.otodock.text": "{text.link-hover}"}},
    "subtle": {"$value": "{action.subtle}", "$extensions": {"io.otodock.modes": {"dark": "{action.subtle}"}}},
    "mark": {"$value": "{color.blue.800}", "$extensions": {"io.otodock.modes": {"dark": "{color.white}"}}, "$description": "The mark: the mid blue on light surfaces, white on dark ones, never navy. Never beside a primary button on a white row."}
  },
  "hero": {
    "$type": "color",
    "$description": "The saturated navy surfaces: login, the boot screen, the website header. The same in both modes.",
    "bg": {"$value": "{color.navy.900}"},
    "deep": {"$value": "{color.navy.950}"},
    "surface": {"$value": "{color.navy.800}"},
    "border": {"$value": "{color.navy.700}"},
    "text": {"$value": "{color.ink.50}"},
    "text-muted": {"$value": "{color.navy.300}"},
    "radius": {"$type": "dimension", "$value": "{radius.2xl}"}
  },
  "status": {
    "$type": "color",
    "$description": "One colour per meaning. fg is tinted text on bg, on a card or on an overlay. bg and border make a pill. solid is a dot, a bar or an icon at 3:1 on every surface. fill carries text-on-solid.",
    "success": {
      "fg": {"$value": "{color.green.750}", "$extensions": {"io.otodock.modes": {"dark": "{color.green.400}"}}},
      "bg": {"$value": "{color.green.100}", "$extensions": {"io.otodock.modes": {"dark": "{color.green.950}"}}},
      "border": {"$value": "{color.green.200}", "$extensions": {"io.otodock.modes": {"dark": "{color.green.900}"}}},
      "solid": {"$value": "{color.green.600}", "$extensions": {"io.otodock.modes": {"dark": "{color.green.500}"}}}
    },
    "warning": {
      "fg": {"$value": "{color.amber.750}", "$extensions": {"io.otodock.modes": {"dark": "{color.amber.400}"}}},
      "bg": {"$value": "{color.amber.100}", "$extensions": {"io.otodock.modes": {"dark": "{color.amber.950}"}}},
      "border": {"$value": "{color.amber.200}", "$extensions": {"io.otodock.modes": {"dark": "{color.amber.900}"}}},
      "solid": {"$value": "{color.amber.600}", "$extensions": {"io.otodock.modes": {"dark": "{color.amber.500}"}}},
      "$description": "Amber, the only attention hue: there is no separate yellow."
    },
    "danger": {
      "fg": {"$value": "{color.red.700}", "$extensions": {"io.otodock.modes": {"dark": "{color.red.400}"}}},
      "bg": {"$value": "{color.red.100}", "$extensions": {"io.otodock.modes": {"dark": "{color.red.950}"}}},
      "border": {"$value": "{color.red.200}", "$extensions": {"io.otodock.modes": {"dark": "{color.red.900}"}}},
      "solid": {"$value": "{color.red.600}", "$extensions": {"io.otodock.modes": {"dark": "{color.red.500}"}}},
      "fill": {"$value": "{color.red.600}", "$extensions": {"io.otodock.modes": {"dark": "{color.red.600}"}}, "$description": "The danger button's fill, under text-on-solid."},
      "fill-hover": {"$value": "{color.red.800}", "$extensions": {"io.otodock.modes": {"dark": "{color.red.800}"}}}
    },
    "info": {
      "fg": {"$value": "{color.slate.700}", "$extensions": {"io.otodock.modes": {"dark": "{color.ink.200}"}}},
      "bg": {"$value": "{color.slate.100}", "$extensions": {"io.otodock.modes": {"dark": "{color.slate.850}"}}},
      "border": {"$value": "{color.slate.300}", "$extensions": {"io.otodock.modes": {"dark": "{color.slate.800}"}}},
      "solid": {"$value": "{color.slate.500}", "$extensions": {"io.otodock.modes": {"dark": "{color.slate.400}"}}},
      "$description": "Slate, never the action blue, so an info pill never reads as a link."
    }
  },
  "accent": {
    "$type": "color",
    "agent": {
      "fg": {"$value": "{color.purple.700}", "$extensions": {"io.otodock.modes": {"dark": "{color.purple.400}"}}},
      "bg": {"$value": "{color.purple.100}", "$extensions": {"io.otodock.modes": {"dark": "{color.purple.950}"}}},
      "border": {"$value": "{color.purple.200}", "$extensions": {"io.otodock.modes": {"dark": "{color.purple.900}"}}},
      "solid": {"$value": "{color.purple.700}", "$extensions": {"io.otodock.modes": {"dark": "{color.purple.400}"}}},
      "fill": {"$value": "{color.purple.700}", "$extensions": {"io.otodock.modes": {"dark": "{color.purple.600}"}}, "$description": "A purple fill under text-on-solid (a task row, a selected agent chip)."},
      "$description": "Purple: agent work, the thinking block, delegation, the shared-scope chips."
    },
    "media": {
      "fg": {"$value": "{color.teal.700}", "$extensions": {"io.otodock.modes": {"dark": "{color.teal.400}"}}},
      "bg": {"$value": "{color.teal.100}", "$extensions": {"io.otodock.modes": {"dark": "{color.teal.950}"}}},
      "border": {"$value": "{color.teal.200}", "$extensions": {"io.otodock.modes": {"dark": "{color.teal.900}"}}},
      "solid": {"$value": "{color.teal.600}", "$extensions": {"io.otodock.modes": {"dark": "{color.teal.500}"}}},
      "$description": "Teal: images, video, audio, the media tools."
    }
  },
  "glass": {
    "$type": "color",
    "$description": "Glass (a translucent fill under a blur) is for the chat chrome only: the top bar's pills, the Active now panel, the composer.",
    "fill": {"$value": "#ffffffb8", "$extensions": {"io.otodock.modes": {"dark": "#111f32c7"}}, "$description": "Light: white at 72 percent. Dark: navy.850 at 78 percent."},
    "hover": {"$value": "#ffffffe6", "$extensions": {"io.otodock.modes": {"dark": "#14273de0"}}, "$description": "Light: white at 90 percent. Dark: navy.750 at 88 percent."},
    "border": {"$value": "#d6d2ce99", "$extensions": {"io.otodock.modes": {"dark": "#ffffff1a"}}, "$description": "Light: warm.300 at 60 percent. Dark: white at 10 percent."}
  },
  "focus": {
    "$type": "color",
    "ring": {"$value": "{color.blue.500}", "$extensions": {"io.otodock.modes": {"dark": "{color.blue.400}"}}, "$description": "The focus ring, 3:1 on every surface."}
  },
  "code": {
    "$type": "color",
    "$description": "The code block's slab (the syntax theme is dark in both modes).",
    "bg": {"$value": "{color.ink.900}", "$extensions": {"io.otodock.modes": {"dark": "{color.ink.950}"}}},
    "fg": {"$value": "{color.ink.50}", "$extensions": {"io.otodock.modes": {"dark": "{color.ink.50}"}}},
    "border": {"$value": "#ffffff33", "$extensions": {"io.otodock.modes": {"dark": "#ffffff33"}}, "$description": "The slab's edge, white at 20 percent: the slab is two steps under the ink page, so without it a block has no edge in dark. Nearly invisible on a light page."}
  },
  "scrollbar": {
    "$type": "color",
    "thumb": {"$value": "{color.warm.300}", "$extensions": {"io.otodock.modes": {"dark": "#ffffff2e"}}, "$description": "Dark: white at 18 percent."},
    "thumb-hover": {"$value": "{color.warm.500}", "$extensions": {"io.otodock.modes": {"dark": "#ffffff47"}}, "$description": "Dark: white at 28 percent."}
  },
  "elevation": {
    "$type": "shadow",
    "$description": "Four levels by layer: 1 cards, 2 raised, 3 popovers, menus and tooltips, 4 dialogs.",
    "1": {"$value": [{"offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px", "color": "#1018280f"}, {"offsetX": "0px", "offsetY": "1px", "blur": "3px", "spread": "0px", "color": "#1018280a"}], "$extensions": {"io.otodock.modes": {"dark": [{"offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px", "color": "#00000066"}]}}},
    "2": {"$value": [{"offsetX": "0px", "offsetY": "2px", "blur": "6px", "spread": "-1px", "color": "#10182814"}, {"offsetX": "0px", "offsetY": "1px", "blur": "3px", "spread": "0px", "color": "#1018280f"}], "$extensions": {"io.otodock.modes": {"dark": [{"offsetX": "0px", "offsetY": "2px", "blur": "8px", "spread": "-2px", "color": "#00000080"}]}}},
