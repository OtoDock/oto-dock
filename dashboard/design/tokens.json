    "body": {"$value": "{text.primary}", "$extensions": {"io.otodock.modes": {"dark": "{text.primary}"}}},
    "headings": {"$value": "{text.primary}", "$extensions": {"io.otodock.modes": {"dark": "{text.primary}"}}},
    "lead": {"$value": "{text.secondary}", "$extensions": {"io.otodock.modes": {"dark": "{text.secondary}"}}},
    "links": {"$value": "{text.link}", "$extensions": {"io.otodock.modes": {"dark": "{text.link}"}}},
