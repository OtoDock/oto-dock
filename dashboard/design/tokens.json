    "4": {"$value": [{"offsetX": "0px", "offsetY": "24px", "blur": "48px", "spread": "-12px", "color": "#10182840"}], "$extensions": {"io.otodock.modes": {"dark": [{"offsetX": "0px", "offsetY": "24px", "blur": "56px", "spread": "-12px", "color": "#000000b3"}, {"offsetX": "0px", "offsetY": "0px", "blur": "0px", "spread": "1px", "color": "#ffffff0f"}]}}}
  },
  "prose": {
    "$type": "color",
