# OtoDock settings
#
# Copy this file to config.env and edit it. A Docker install names it .env and
# keeps it next to docker-compose.yml. The server, the phone service and the
# Docker MCPs all read this one file.
#
# A line that starts with # is off. Remove the # to set the key. The value
# shown is the key's default, or an example where the text says so. An empty
# value means the key is not set, unless the key's own text says otherwise.
#
# A yes or no key takes true or false. It also takes 1 or 0, yes or no, and on
# or off, in any case. A number key takes a whole number. It takes a decimal
# only where the value shown here has one. Any other word stops the server at
# start, with a message that names the key.
#
# A key in this file that nothing reads is named once in the start log. That
# is usually a misspelt key.
#
# The first section holds the keys most installs set. From "Sessions" on, the
# sections hold limits and tuning.

# ── Start here ──

# The address people open in their browser. Without a reverse proxy, keep
# its port equal to PROXY_PORT. Behind a reverse proxy or a tunnel, give the
# public address, for example https://otodock.example.com.
#
# An https address makes the sign-in cookie Secure. An http address does not.
# After a change on a running install, run docker compose up -d again, or
# scripts/compose.sh up -d. A restart alone keeps the old address, and
# document previews then fail.
DASHBOARD_PUBLIC_URL=http://localhost:8400

# The port OtoDock listens on. On a Docker install it is the port on the
# host. The container keeps 8400 inside.
PROXY_PORT=8400

# The server's timezone, as an IANA name such as the example below.
# A source install reads the system's timezone by itself. A Docker install
# runs on UTC unless you set this key.
# On the first install it becomes the platform timezone, which tasks and
# agents use. It never replaces what an admin sets later.
# TZ=Europe/Athens

# Behind a reverse proxy: the address it connects from. Give IPs or CIDRs,
# with commas between them. OtoDock then reads each visitor's own address
# from X-Forwarded-For, and only from these addresses.
# Wrong or empty behind a reverse proxy, every visitor shares its address.
# Ten failed sign-ins from anyone then lock everybody out.
#
# The value depends on where the reverse proxy runs.
# On this host, with a source install: leave it empty. 127.0.0.1 is trusted.
# On this host, with a Docker install: 10.200.0.1, the gateway of the otodock
# network. Also set PROXY_BIND_IP to 127.0.0.1.
#
# In a container on the otodock network: that container's fixed address.
# Never give the whole range.
# On another machine: that machine's IP.
# The guide: https://docs.otodock.io/getting-started/reverse-proxy
# TRUSTED_PROXY=

# Docker install: the host address the port listens on. Empty: every address
# of the host.
# With a reverse proxy on this host, set 127.0.0.1 as in the example, and
# set TRUSTED_PROXY. Then only the reverse proxy reaches OtoDock.
# PROXY_BIND_IP=127.0.0.1

# A Docker install set up by hand, without scripts/install.sh, also sets
# POSTGRES_PASSWORD. It is under "Database" below.

# ── Secrets ──
# Leave these four empty. The server makes each one on the first run and
# writes it into this file.
# A value you set yourself needs at least 32 characters. This command makes
# one:
#   openssl rand -base64 48
# A new JWT_SECRET that is shorter stops the start. A shorter one that is
# already in use only draws a warning.

# The master API key of this install.
PROXY_API_KEY=
# The secret that signs sign-ins and tokens. Do not change it while
# CREDENTIAL_ENCRYPTION_KEY is empty. The stored secrets would not open after
# that.
JWT_SECRET=
# The key pair for web push notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional: the key that encrypts the stored secrets, which are MCP and
# engine credentials, 2FA and SMTP. Empty: a key made from JWT_SECRET
# encrypts them. 32 characters or more.
# To rotate, give several keys with commas between them. The first key
# encrypts, and the others only decrypt.
#
# Once set, keep every key in the list. A secret opens only while the key
# that wrote it is there. A secret saved before this key was set needs the
# JWT_SECRET of that time.
# CREDENTIAL_ENCRYPTION_KEY=

# ── Database ──

# The password of the bundled PostgreSQL, and the address of the database.
# The address below is an example.
#
# Source install: leave both empty on a new install. proxy/setup.sh then
# writes a strong password and the matching address into config.env. Set
# both yourself for a database that runs elsewhere.
#
# Docker install: scripts/install.sh writes the password. If you write .env
# by hand, set the password before the first start. Docker Compose refuses
# to run without it.
# DATABASE_URL in this file is ignored on a Docker install. Its compose file
# sets the address, which is otodock-postgres:5432.
# POSTGRES_PASSWORD=
# DATABASE_URL=postgresql://otodock:CHANGE_ME@localhost:5432/otodock

# Optional: a network password for otodock_admin, the superuser of the
# bundled PostgreSQL, for tools such as pgAdmin.
# Empty: the superuser has no network password. You reach it only this way:
#   docker compose exec otodock-postgres psql -U otodock_admin -d otodock
# Set, the password is applied on every start. Empty again, the next start
# removes it.
# OTODOCK_DB_ADMIN_PASSWORD=

# Docker install: seconds the start waits for PostgreSQL to accept
# connections. A large database needs longer before it does.
# OTODOCK_DB_INIT_WAIT_S=180

# A server refuses to start on a database that a newer release has migrated.
# Set true to start anyway. The server may then misread the newer data.
# OTODOCK_ALLOW_NEWER_DATABASE=false

# ── Server ──

# Source install: the address the server listens on. A Docker install fixes
# its own.
# PROXY_HOST=0.0.0.0

# Docker install: the release OtoDock runs. Empty: the release the compose
# files came with.
# scripts/upgrade.sh sets it together with that release's compose files. A
# new value alone keeps the old compose files, which is not an upgrade.
# OTODOCK_VERSION=

# Serve the dashboard from this server. false: the API alone.
# DASHBOARD_ENABLED=true

# Forces the Secure flag of the sign-in cookie: true or false. Empty: the
# flag follows DASHBOARD_PUBLIC_URL. Set it when your reverse proxy's scheme
# differs from that address's.
#
# Never set true for a plain http address. The browser drops a Secure cookie
# there. Sign-in then seems to work, and every page after it fails.
# COOKIE_SECURE=

# Seconds an update or a restart waits for running chats and tasks. 0: no
# wait.
# OTODOCK_DRAIN_BOUND_S=600

# A token that a scraper sends to read /metrics, as Authorization: Bearer
# <token>. At least 32 characters. With or without a token, a signed-in
# admin reads /metrics, and so does the master API key from this machine.
# OTODOCK_METRICS_TOKEN=

# Source install: where the Claude Code and Codex programs are, when they
# are not on the service's PATH. The installer puts them there.
# CLAUDE_BIN=
# CODEX_BIN=

# ── Sign-in ──

# Hours a dashboard sign-in stays valid. Admin, Platform can set it too.
# JWT_EXPIRY_HOURS=168

# Cloudflare Turnstile keys, which keep bots off the sign-in page. Usually
# empty: set the keys in Setup → Security.
# When both are set here, they win over the keys saved there. The admin page
# then shows them as managed. The values below are examples.
# OTODOCK_TURNSTILE_SITE_KEY=0x4AAAAAAA...
# OTODOCK_TURNSTILE_SECRET_KEY=0x4AAAAAAA...

# ── Single sign-on ──
# Optional. It works with Authentik, Keycloak, Authelia, oauth2-proxy,
# Cloudflare Access and other OIDC providers.

# Set true to turn single sign-on on. Default: false.
# OIDC_ENABLED=true
# The provider's name on the sign-in button: "Sign in with <name>".
# OIDC_PROVIDER_NAME=SSO
# With single sign-on on: true skips OtoDock's sign-in page and goes straight
# to the provider. Without single sign-on the key does nothing.
# AUTH_PROVIDER_BYPASS=false

# The provider's discovery address, fetched at start. The four endpoint
# addresses come from it. The address below is an example.
# OIDC_DISCOVERY_URL=https://auth.example.com/application/o/<app-slug>/.well-known/openid-configuration
# The client ID and the client secret from the provider.
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# The provider's group for each role. The names below are examples. A role
# with no group here is not mapped.
# The groups also decide who gets in. A person in none of them cannot sign in
# with single sign-on, so name at least one group.
# OIDC_ROLE_ADMIN_GROUP=OtoDock Admin
# OIDC_ROLE_CREATOR_GROUP=OtoDock Creator
# OIDC_ROLE_MEMBER_GROUP=OtoDock Member

# Advanced: the four endpoints one by one. Set them when your provider has no
# discovery address, or to fix one of them.
# OIDC_AUTHORIZE_URL=
# OIDC_TOKEN_URL=
# OIDC_USERINFO_URL=
# OIDC_LOGOUT_URL=

# The issuer and the signing keys of the ID token, which the sign-in checks.
# Discovery names both. Without discovery they come from the token's issuer,
# when that issuer is on the token endpoint's host. Or set them here.
# OIDC_ISSUER=
# OIDC_JWKS_URL=

# The scopes to ask for. openid is always added.
# OIDC_SCOPES=openid profile email groups

# The callback address. Empty: DASHBOARD_PUBLIC_URL followed by
# /auth/callback.
# OIDC_REDIRECT_URI=

# Making an external link from a provider account takes a plain sign-in
# round trip. The provider says it is the same account.
# Set true to ask for a new sign-in there (prompt=login) and to refuse an old
# one. Do so only for a provider whose flows honour that. Authentik's
# defaults do not.
# OIDC_CONFIRM_FRESH_LOGIN=false
# With the key above: refuse an ID token that carries no auth_time.
# OIDC_CONFIRM_REQUIRE_AUTH_TIME=false

# ── Outbound proxy ──
# Of the proxy settings, only HTTPS_PROXY and NO_PROXY belong in this file.
# Never put HTTP_PROXY or ALL_PROXY here. A source install's service reads
# every line of this file, and those two break the server's internal calls.
# A Docker install never reads those two from this file.

# A proxy for the calls the server itself makes to the internet. Those are
# the catalogs, push, usage checks, Microsoft sign-in and Twilio.
# You need it when your DNS answers a public name with a private or a fake
# address. The address below is an example.
#
# Agents' https calls on this install's own compute machine go through this
# proxy too, and so do the AI engines'. A compute machine on another server
# and a paired computer use their own proxy settings. A SOCKS proxy does not
# work for agents: their tools that need a key stay off.
# HTTPS_PROXY=http://proxy.example.com:3128

# The hosts that never go through that proxy. With no NO_PROXY set anywhere,
# they are this machine and OtoDock's own Docker services.
# A value replaces that list. So keep localhost and 127.0.0.1 in it. Then add
# the https hosts of your own network, such as a model server.
# NO_PROXY=

# ── OtoDock relay ──
# An install reaches the OtoDock relay without any setting. The relay carries
# push to the mobile apps, hosted account connects and license activation.

# Set true and this install never contacts OtoDock. Default: false.
# OTODOCK_AIR_GAPPED=true

# Another address for the relay, such as a private or a test one. Default:
# https://api.otodock.io. The value below is a placeholder.
# OTODOCK_RELAY_BASE=...

# Once a day the server asks GitHub for the latest OtoDock release. It tells
# admins with a banner and a notification when a newer one exists.
# Set false to turn that off. With OTODOCK_AIR_GAPPED true, the server never
# asks.
# OTODOCK_RELEASE_CHECK=true
# Where the server asks. A mirror works when it answers like GitHub's
# releases/latest.
# OTODOCK_RELEASE_CHECK_URL=https://api.github.com/repos/OtoDock/oto-dock/releases/latest

# ── Push notifications ──

# The contact email of the web push keys.
VAPID_EMAIL=admin@localhost

# Advanced: send push to the mobile apps from your own Firebase project and
# not through the relay. Give the path of its service account file. The path
# below is an example. You also rebuild the app with your own
# google-services.json.
# FCM_SERVICE_ACCOUNT_PATH=/path/to/your-fcm-service-account.json

# ── Forced settings ──

# Forces platform settings, so that nobody changes them in the dashboard. It
# also reaches a setting that has no control there, such as the apps' store
# rating ask.
# The value is a JSON object of keys and values, as in the example. Write
# true or false for a switch. Write a number or a text in quotes, such as
# "180".
#
# Policy settings can be forced too, for example:
#   OTODOCK_FORCED_SETTINGS={"session_retention_enabled":true,"session_retention_days":"180","smtp_host":"mail.example.com","smtp_port":"587","password_min_score":"3"}
#
# The key is read once at start, so restart OtoDock after a change.
# An empty value, JSON that does not parse or a value that is no object
# forces nothing.
# Never put license_key in it. A forced value would stop the relay from
# issuing that key again.
# OTODOCK_FORCED_SETTINGS={"store_review_enabled":false,"store_review_days":"180"}

# ── Document editor ──
# The document editor is Collabora Online. Set DASHBOARD_PUBLIC_URL and the
# previews work. Your reverse proxy or tunnel needs only the route to the
# dashboard. Set a key of this section only for a setup that differs.

# The editor's public address. Empty: DASHBOARD_PUBLIC_URL followed by
# /collabora. Set it only when the editor has a host name of its own, for
# example https://collabora.example.com.
# COLLABORA_URL=

# Whether HTTPS ends in front of the editor: true when DASHBOARD_PUBLIC_URL
# starts with https. The installer, the upgrade script and the setup wizard
# write it for you. So does the server at its start, when this file sets
# DASHBOARD_PUBLIC_URL and no COLLABORA_URL.
# A wrong value leaves the editor blank. A change applies at the next docker
# compose up -d.
# COLLABORA_SSL_TERMINATION=false

# Accept document calls that Collabora did not sign. Set true only while a
# Collabora that does not sign runs, such as your own one without its key.
# The server logs a warning every hour while it applies.
# WOPI_ACCEPT_UNSIGNED=false

# The address Collabora calls to fetch and save files. Collabora's container
# must reach it. It is often the server's LAN IP and port, as in the example,
# and not the public name.
# Empty on a Docker install: http://otodock-proxy:8400. Empty otherwise:
# http://host.docker.internal:<PROXY_PORT>.
# WOPI_BASE_URL=http://192.168.1.10:8400

# Where the server reaches Collabora. The default suits a source install. On
# a Docker install it is http://collabora:9980.
# COLLABORA_BACKEND_URL=http://localhost:9981

# Source install: the address the editor's port 9981 listens on.
# Set 0.0.0.0 or this host's LAN address only in one case. That is when a
# reverse proxy on another host sends a COLLABORA_URL host name to this port.
# COLLABORA_BIND_IP=127.0.0.1

# The path the editor is served under on the dashboard's address. It comes
# from COLLABORA_URL, so it is /collabora by default. It is empty when the
# editor has a host name of its own.
# COLLABORA_SERVICE_ROOT=

# Docker install: the Collabora that the file tools use to draw and
# recalculate documents. Not set: the Collabora of this install, at the
# address shown.
# Set to empty: none, and LibreOffice inside the file tools does all of it.
# An address names another Collabora. Include its service root.
# OTODOCK_FILETOOLS_COLLABORA_URL=http://collabora:9980/collabora

# Docker install: the memory cap of the file tools' container. Raise it if
# you read very heavy documents. Below 3g it runs one LibreOffice conversion
# at a time. 0: no cap.
# OTODOCK_FILETOOLS_MEM_LIMIT=4g

# ── Phone ──
# Optional. Only an install that uses phone calls needs these keys.

# The address of the phone service. Plain http is for this machine, a private
# network or a Docker service name. Across the internet use https. Nothing is
# sent to a public http address.
PHONE_SERVER_URL=http://127.0.0.1:9093

# The address your PBX dials to reach the phone service. That is AudioSocket
# on port 9092 and the register API on port 9093.
# A source install finds the address by itself. A Docker install finds a
# wrong one. Set the Docker host's LAN IP there, as in the example.
# OTO_AUDIOSOCKET_PUBLIC_HOST=192.168.1.10

# Docker install: the host address those two ports listen on. Empty: the
# address in OTO_AUDIOSOCKET_PUBLIC_HOST. When that is empty too: 127.0.0.1.
#
# Set a LAN IP of this host in two cases. When that key holds a host name,
# docker compose refuses the whole file and no service starts. When it holds
# an address this host does not own, the phone container fails to start.
# Never 0.0.0.0 on a host the internet reaches. AudioSocket has no sign-in of
# its own.
# OTO_PHONE_BIND=

# Calls that agents may place through the platform. 0: no cap.
# Per agent, each hour.
# PHONE_CALLS_PER_AGENT_PER_HOUR=10
# Per tied user, each hour.
# PHONE_CALLS_PER_USER_PER_HOUR=5
# Per agent, each day.
# PHONE_CALLS_PER_AGENT_PER_DAY=50

# Optional: the E.164 prefixes a called number must start with, with commas
# between them. For example +30,+357. Empty: any number.
# PHONE_CALL_ALLOWED_PREFIXES=

# Calls through your own PBX, Asterisk or FreePBX, over AudioSocket. On an
# install you host yourself, auto means on, and true or false forces it.
# OTODOCK_LOCAL_PBX_ENABLED=auto

# ── Audio and video playback ──
# Optional. ffmpeg and ffprobe convert audio and video that a browser cannot
# play. Only the server uses them, never an agent's sandbox or a remote
# machine.

# Where the two programs are. Empty: the ones on the host's PATH.
# In production, keep them outside /usr, /bin, /lib and /sbin. An agent's
# sandbox then cannot even see them. For example /opt/otodock/bin/ffmpeg and
# /opt/otodock/bin/ffprobe.
# OTO_FFMPEG_PATH=
# OTO_FFPROBE_PATH=

# The folder for converted media. Empty: media-cache in the platform's data
# folder.
# OTO_MEDIA_CACHE_DIR=

# ── MCPs ──

# Let the MCP installer install missing system packages with sudo. false: it
# names them and stops.
# MCP_AUTO_INSTALL_SYSTEM_DEPS=false

# The largest size of an uploaded MCP zip once unpacked, in bytes.
# MCP_ZIP_DECOMPRESSED_MAX=524288000

# Build the images of Docker MCPs here, and do not pull the catalog's.
# OTODOCK_MCP_BUILD_LOCAL=false

# The memory cap of a Docker MCP that declares none. An MCP's own limit
# always wins. Set 0 or none to add no cap.
# OTODOCK_MCP_DEFAULT_MEM_LIMIT=2g

# Minutes a Docker MCP's container runs without use before it stops. Its
# next use starts it again in a few seconds. 0: it never stops.
# OTODOCK_TOOLS_IDLE_MINUTES=15

# Google OAuth for the Workspace MCPs. The usual way is the app credential
# saved in Admin, MCP Servers. These keys apply when none is saved there.
# An empty redirect address is made from DASHBOARD_PUBLIC_URL.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=

# ── Network ranges ──
# OtoDock's own Docker networks use these address ranges. Change one only
# when it overlaps your LAN, or when a second install shares this Docker.

# Docker install: the network of the Docker socket proxy.
# OTODOCK_SOCKETPROXY_SUBNET=10.202.0.0/24
# Docker install: the network of PostgreSQL.
# OTODOCK_DATA_SUBNET=10.203.0.0/24
# Docker install: the network of the file tools and Collabora.
# OTODOCK_INTERNAL_SUBNET=10.204.0.0/24

# Docker install: the compute service's own network, and the two addresses on
# it. Change all three together.
# OTODOCK_COMPUTE_SUBNET=10.205.0.0/24
# The compute service's address.
# OTODOCK_COMPUTE_ADDRESS=10.205.0.10
# The server's address.
# OTODOCK_COMPUTE_PROXY_ADDRESS=10.205.0.2

# Source install: the address range the networks of Docker MCPs come from.
# OTODOCK_MCP_ADDRESS_POOL=10.201.0.0/16

# ── Compute machine ──
# Chats, tasks, calls and apps of the platform run on the install's compute
# machine. That is the otodock-compute service, or the compute unit of a
# source install. They cannot run while it is not signed in.

# Docker install: the memory cap of the compute service. 0: no cap, as for
# the server. A cap here also limits the service's own sessions.
# OTODOCK_COMPUTE_MEM_LIMIT=0
# Docker install: the most processes the compute service may hold. 0: no cap.
# OTODOCK_COMPUTE_PIDS_LIMIT=32768

# The image that a compute machine on another server runs. Leave it empty on
# a released install. Those machines run the image this install runs.
# An install built from source names the image it loads on those servers,
# with a new tag for each build. Without this key, such an install adds no
# machine on another server.
# OTODOCK_REMOTE_COMPUTE_IMAGE=

# ── Sessions ──
# Agents always run isolated, on the compute machine. That machine needs
# passt, iproute2 and unprivileged user namespaces. The installer sets them
# up. Without them it runs no session, and it says why.
# For work on a whole machine, use a remote machine.

# The longest a chat turn may run, in seconds. Admin, Platform can set it too.
# CLAUDE_TIMEOUT=7200
# Seconds an idle session is kept, for every engine. Admin, Platform can set
# it too.
# PERSISTENT_SESSION_TIMEOUT=900
# Only the start log reads this key. Leave it unset.
# DIRECT_SESSION_TIMEOUT=900
# Seconds a session with background work is spared past idle. Empty: the
# value of CLAUDE_TIMEOUT.
# BACKGROUND_WORK_CEILING_S=7200

# Seconds a chat turn may stream nothing, with no tool running, at least 60.
# It then ends with the "silent" card.
# Raise it for a Claude Code or Codex chat on a slow local model. That is one
# that thinks for more than 10 minutes before its first word. A Direct LLM
# chat has no such limit.
# TURN_SILENCE_S=600

# The size of /tmp in every local sandbox, in MB. It is held in RAM. 0: no
# cap.
# SANDBOX_TMP_SIZE_MB=4096

# Sessions one person may hold at once. 0: no cap.
# OTODOCK_MAX_SESSIONS_PER_USER=8
# Session processes the compute machine starts at once. 0: half its CPUs, at
# least 2. A personal computer always keeps that bound.
# SESSION_SPAWN_CONCURRENCY=0
# Seconds between two writes of the session index.
# SESSION_INDEX_FLUSH_S=2.0
# Seconds a session start waits for a free slot.
# ADMISSION_QUEUE_WAIT_S=30.0
# Seconds a parked delegate result or continuation wake waits for a slot. It
# is then stored for the chat's next turn.
# ADMISSION_WAKE_WAIT_S=600.0

# ── Engines ──

# Claude Code's thinking budget, in tokens.
# MAX_THINKING_TOKENS=100000
# The answer budget of Direct LLM, in tokens.
# DIRECT_LLM_MAX_TOKENS=8192
# On the OpenAI Responses API: the budget of an answer that carries
# reasoning.
# DIRECT_LLM_OPENAI_REASONING_MAX_TOKENS=32768
# The OpenAI API that Direct LLM speaks: responses or chat.
# DIRECT_LLM_OPENAI_API=responses
# Deferred tool loading on Direct LLM sessions: auto, on or off.
# DIRECT_LLM_TOOL_SEARCH=auto
# The size of the tool schemas, in tokens, past which auto defers them.
# DIRECT_LLM_TOOL_SEARCH_THRESHOLD_TOKENS=6000

# ── Memory ──
# OtoDock starts a new local session only when the machine has the memory
# for it. When sessions fill the machine, idle ones are closed to make room.
# The server's own host, with no session on it, always starts its first one.
# The defaults suit 8 GB or more. On 4 to 8 GB you mostly leave them alone.
#
# As a guide, 4 GB fits one or two Claude Code or Codex sessions. It fits
# three or four Direct LLM sessions.
# The compute service follows some of these keys as the server does. They
# are the estimates, the swap credit, the share, the reserve and the idle
# age.

# The estimate: MB reserved for a Claude Code or Codex session. Go below the
# measured use only if you accept a tighter fit than the real one.
# SESSION_EST_HEAVY_MB=850
# The least the estimate for a Direct LLM session can be, in MB.
# SESSION_EST_LIGHT_MB=250

# The swap credit: half of the free swap counts as free memory, up to this
# many MB. A small machine with swap then fits one more session. 0: off.
# A machine's memory guard reads it too. Free memory may then fall that far
# under the reserve before a runaway command is stopped.
# SESSION_SWAP_CREDIT_MB=0

# The share of the total memory that sessions may reserve together.
# BUDGET_FRACTION=0.90

# The reserve: MB of free memory that must remain after a session starts. The
# larger of this and 5% of the total applies.
# SESSION_RESERVE_FLOOR_MB=512

# The most memory one session may use, in MB. It holds on compute machines
# and on computers an admin paired. It is never under 6144. 0: everything
# above the reserve.
# OTODOCK_SESSION_MEMORY_MAX_MB=0

# The idle age: seconds a session must be idle before it may be closed to
# admit another.
# SESSION_EVICT_FLOOR_S=300

# Optional: a hard cap on the sessions that run at once on this install's own
# machines. That is the server and its compute service together. 0: off. The
# memory keys above are the intended control.
# OTODOCK_MAX_LOCAL_SESSIONS=0

# Docker install: the memory cap of the server's container, for example 12g.
# The sessions run in the compute service: cap them with
# OTODOCK_COMPUTE_MEM_LIMIT. 0: no cap.
# OTODOCK_PROXY_MEM_LIMIT=0
# Docker install: the most processes the server's container may hold. 0: no
# limit.
# OTODOCK_PROXY_PIDS_LIMIT=32768

# ── Tasks ──

# Seconds between the session starts of scheduled tasks.
# TASK_SPAWN_SPACING_SECONDS=10

# Seconds a delegated follow-up waits for a turn that a restart cut. Then
# the follow-up is given up. At least 300.
# Leave it unset. Under ten minutes, a follow-up ends as not started while
# its worker is only slow to come back.
# LANE_GATE_CEILING_S=1800

# Active scheduled and one-time tasks: the most one person may create and one
# agent may hold. Admins are exempt. 0: no cap.
# TASK_MAX_ACTIVE_PER_USER=25
# TASK_MAX_ACTIVE_PER_AGENT=100
# Pending self-continuations, per chat and per agent. 0: no cap.
# CONTINUATION_MAX_ACTIVE_PER_CHAT=10
# CONTINUATION_MAX_ACTIVE_PER_AGENT=100

# ── Files and uploads ──

# The largest file, in MB. One cap for every upload in the dashboard and the
# chat, and for the file sync with remote machines. A larger file is refused
# at upload and never syncs.
# OTODOCK_MAX_FILE_MB=1024

# A large upload from the dashboard travels in pieces of at most this many
# MB. Keep it under the request size cap of your reverse proxy or CDN, such
# as Cloudflare's of about 100 MB.
# OTODOCK_UPLOAD_CHUNK_MB=32

# Large uploads one person may have open at once. 0: no cap.
# OTODOCK_UPLOAD_MAX_OPEN=4
# Large uploads open at once, in total. 0: no cap.
# OTODOCK_UPLOAD_MAX_OPEN_TOTAL=256
# MB of unfinished uploads one person may hold. Empty: twice
# OTODOCK_MAX_FILE_MB.
# OTODOCK_UPLOAD_STAGING_USER_MB=2048
# Seconds a started upload may wait for its first piece before it is dropped.
# An upload that has pieces keeps 24 hours to resume.
# OTODOCK_UPLOAD_FIRST_CHUNK_S=3600

# The free space an upload must leave on the data disk, in MB and in per
# cent. The larger of the two applies. A new upload, each piece and the final
# copy are refused below it.
# OTODOCK_MIN_FREE_DISK_MB=5120
# OTODOCK_MIN_FREE_DISK_PCT=5.0

# A text file larger than this many bytes is downloaded, not shown inline.
# INLINE_TEXT_MAX_BYTES=5242880

# Zip downloads built at once.
# ZIP_MAX_CONCURRENT=2
# Paths in one zip request.
# ZIP_MAX_PATHS=500
# Files in one zip archive.
# ZIP_MAX_ENTRIES=100000
# The total size that goes into one zip, in MB.
# ZIP_MAX_INPUT_MB=4096

# Files one copy request may copy.
# COPY_MAX_ENTRIES=100000
# The total size one copy request may copy, in MB.
# COPY_MAX_INPUT_MB=4096

# Temporary public image links: the size of one image, in MB.
# TEMP_IMAGE_MAX_MB=20
# The images of one session.
# TEMP_IMAGE_MAX_PER_SESSION=20
# All of them together, in MB.
# TEMP_IMAGE_MAX_TOTAL_MB=256

# A deleted or overwritten file larger than this many MB gets no undo copy.
# It is far below OTODOCK_MAX_FILE_MB on purpose. Raise it if undo for large
# files matters more to you than the disk space of the recover bin.
# RECOVER_BIN_MAX_MB=100

# ── Storage quotas ──

# auto: hard XFS project quotas when the agents folder supports them, and
# the measuring tier otherwise. off: the measuring tier always.
# OTODOCK_STORAGE_QUOTAS=auto
# The helper that runs xfs_quota. A source install calls it through sudo.
# Empty: proxy/scripts/oto-quota.
# OTODOCK_QUOTA_HELPER=

# ── Request limits ──

# The largest request body for each kind of request, in bytes. 0 turns one of
# these four caps off.
# The sign-in routes.
# MAX_AUTH_BODY_BYTES=65536
# The webhook receivers.
# MAX_WEBHOOK_BODY_BYTES=2097152
# A request with no valid credential.
# MAX_UNAUTH_BODY_BYTES=65536
# Every other route, except uploads and the other routes for large files.
# MAX_JSON_BODY_BYTES=8388608

# The cap over every route. Uploads and the other routes for large files keep
# this one alone. Empty: the file cap plus 64 MB.
# MAX_REQUEST_BODY_BYTES=

# The most entries on one page of a list.
# MAX_PAGE_SIZE=500

# A webhook sender that has been checked may send more, in bytes. Neither cap
# goes below MAX_WEBHOOK_BODY_BYTES.
# A signed delivery from GitHub, GitLab or Jira.
# MAX_WEBHOOK_SIGNED_BODY_BYTES=26214400
# A trigger fire whose API key was verified.
# MAX_WEBHOOK_KEYED_BODY_BYTES=26214400

# Webhook bodies read at once, in bytes. 0: no limit.
# In all.
# MAX_WEBHOOK_INFLIGHT_BYTES=134217728
# Per client address.
# MAX_WEBHOOK_INFLIGHT_BYTES_PER_CLIENT=33554432

# Password hashes computed at once.
# AUTH_HASH_CONCURRENCY=4
# Sign-ins that may wait for their turn. The rest are refused with a retry.
# AUTH_HASH_MAX_WAITERS=64
# Webhook key checks at once.
# WEBHOOK_KEY_VERIFY_CONCURRENCY=2
# Webhook calls that may wait for a check. Further ones are refused.
# WEBHOOK_KEY_VERIFY_MAX_WAITERS=16

# Keys that one sign-in rate bucket keeps, at most.
# RATE_LIMIT_MAX_KEYS=50000

# ── Remote machines ──

# File-change events of one remote machine that may be in flight. More are
# dropped with a warning.
# SAT_FILE_CHANGED_MAX_INFLIGHT_PER_MACHINE=64
# File-change events that run at once, per machine.
# SAT_FILE_CHANGED_CONCURRENCY_PER_MACHINE=4
# File-change events that run at once, in total.
# SAT_FILE_CHANGED_CONCURRENCY_GLOBAL=8
# The size of the last-change map.
# SAT_FILE_CHANGED_STAMP_MAX=4096
# Threads that commit uploaded and pulled files to disk.
# FILE_COMMIT_WORKERS=4

# Large pushes to remote machines that run at once.
# OTODOCK_SYNC_FANOUT_CONCURRENCY=3
# The size from which a push counts as large, in MB.
# OTODOCK_SYNC_FANOUT_MIN_MB=4
# An admin is told when one reconcile plans more new files than this.
# OTODOCK_SYNC_DELTA_ALERT_FILES=2000
# The same, for more new MB than this.
# OTODOCK_SYNC_DELTA_ALERT_MB=500

# File bytes on their way to one remote machine, at most.
# BULK_CREDIT_BYTES=1048576
# Seconds a push to a remote machine may stand still before it fails.
# PUSH_STALL_S=90.0
# Seconds a pull from a remote machine may stand still before it fails.
# PULL_STALL_S=90.0
# Bytes queued for one remote machine. A machine that reads too slowly is
# disconnected, and it catches up when it reconnects.
# SAT_SEND_QUEUE_MAX_BYTES=67108864
# File names one agent may be owed on one machine. Past it, one merge settles
# them.
# SAT_PUSH_LANE_MAX_NAMES=100000

# ── Server tuning ──
# The database connections and the server's event loop. The defaults suit
# about 100 sessions at once. At the defaults one server holds at most 52
# database connections, and PostgreSQL allows 100. Times are in seconds.

# Connections of the shared database pool, at most.
# DB_POOL_MAX_SIZE=30
# How long a thread waits for a connection of the shared or a lane pool.
# DB_POOL_TIMEOUT_S=10.0
# Threads of the fast database lane.
# DB_FAST_LANE_WORKERS=6
# Threads of the bulk database lane.
# DB_BULK_LANE_WORKERS=10
# How long the event loop waits for a connection of its own pool.
# DB_LOOP_POOL_TIMEOUT_S=0.5
# How long database calls on the event loop then fail at once, at least.
# DB_LOOP_BREAKER_S=5.0
# After a call on the event loop has waited this long, the server asks
# whether PostgreSQL still answers. 0: off.
# DB_LOOP_LIVENESS_PROBE_S=1.0
# How long PostgreSQL lets one statement run. 0: off.
# DB_STATEMENT_TIMEOUT_S=300.0
# How long PostgreSQL lets a transaction stay open and idle. 0: off.
# DB_IDLE_IN_TX_TIMEOUT_S=60.0

# Threads for the server's work off the event loop.
# DEFAULT_EXECUTOR_WORKERS=32
# Open connections past which a new HTTP request is refused. 0: off.
# HTTP_LIMIT_CONCURRENCY=4000
# Bytes a WebSocket may buffer. Past it, the sender waits for the reader.
# WS_WRITE_BUFFER_MAX_BYTES=4194304
# A WebSocket that takes nothing from a full buffer for this long is closed.
# WS_WRITE_STALL_S=60.0

# A stall of the event loop this long is logged, with the code that blocks
# it. 0: off.
# LOOP_WATCHDOG_THRESHOLD_S=2.0
# A shorter stall from this long up is logged once. 0: off.
# LOOP_WATCHDOG_REPORT_S=0.25
