{
  "name": "meetings-mcp",
  "label": "Meeting Rooms",
  "description": "Multi-agent meeting collaboration",
  "version": "1.1.3",
  "category": "core",
  "server": {
    "runtime": "python",
    "transport": "stdio",
    "command": "venv/bin/python",
    "args": ["server.py"]
  },
  "credentials": {
    "type": "none"
  },
  "config": [
    {
      "key": "MAX_PARALLEL_SPAWNS",
      "label": "Max parallel meeting participants per user (0 allows no meeting)",
      "input_type": "number",
      "default": "4",
      "user_overridable": false
    }
  ],
  "env": {},
  "agent_env": {
    "MEETINGS_MCP_AGENT": "${agent_name}",
    "PROXY_TASK_OWNER": "${session.task_owner}",
    "PROXY_TASK_USERNAME": "${session.task_username}",
    "PROXY_TASK_SCOPE": "${session.task_scope}"
  },
  "exclude_from": ["phone", "terminal", "external"],
  "skills": [
    {
      "id": "meetings",
      "loading": "always",
      "file": "skills/meetings.md",
      "description": "When and how to use multi-agent meetings for collaborative problem-solving",
      "default_exclude_from": ["phone", "terminal"]
    },
    {
      "id": "meetings-guide",
      "loading": "on_demand",
      "file": "skills/meetings-guide/SKILL.md",
      "description": "Reference for the meetings tools — how a meeting runs turn by turn, who may call which tool, moderator and participant practice, an example flow. Use before starting or joining a multi-agent meeting.",
      "default_exclude_from": ["phone", "terminal"]
    }
  ],
  "permissions": {
    "default_tier": "standard",
    "rules": [
      {
        "tool": "direct_to",
        "tier": "open"
      },
      {
        "tool": "propose_conclude",
        "tier": "open"
      },
      {
        "tool": "leave_meeting",
        "tier": "open"
      },
      {
        "tool": "end_meeting",
        "tier": "open"
      }
    ]
  },
  "patched": false,
  "patch_note": null
}
