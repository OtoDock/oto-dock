{
  "name": "image-gen-mcp",
  "label": "Image Generation",
  "description": "AI image generation (Nano Banana Pro, GPT Image 2.6)",
  "version": "1.3.1",
  "category": "custom",
  "server": {
    "runtime": "python",
    "transport": "stdio",
    "command": "venv/bin/python",
    "args": ["server.py"],
    "tool_timeout_sec": 600
  },
  "credentials": {
    "type": "none",
    "exit": [
      {"key": "GOOGLE_AI_API_KEY", "header": "x-goog-api-key", "hosts": ["generativelanguage.googleapis.com"], "streams": true},
      {"key": "OPENAI_IMAGE_API_KEY", "header": "Authorization", "prefix": "Bearer ", "hosts": ["api.openai.com"], "streams": true}
    ]
  },
  "instances": {
    "delivery": "env",
    "fields": [
      {"key": "GOOGLE_AI_API_KEY", "label": "Google AI API Key", "input_type": "password", "secret": true},
      {"key": "OPENAI_IMAGE_API_KEY", "label": "OpenAI Image API Key", "input_type": "password", "secret": true}
    ],
    "max_instances": 0
  },
  "config": [],
  "env": {},
  "agent_env": {},
  "path_env": {
    "IMAGE_SAVE_DIR": {"role": "workspace"}
  },
  "assignment_mode": "explicit",
  "exclude_from": ["meeting"],

  "tool_arg_paths": {
    "generate_image": {
      "save_path": { "mode": "write" }
    },
    "edit_image_ai": {
      "image_path": { "mode": "read" },
      "mask_path":  { "mode": "read" },
      "save_path":  { "mode": "write" }
    }
  },
  "costs": {
    "currency": "USD",
    "provider": "image-gen",
    "rules": [
      {"tool": "generate_image", "match": {"model": "nano-banana"}, "amount": 0.134, "multiply_by": "num_images"},
      {"tool": "generate_image", "match": {"model": "gpt-image", "quality": "high", "aspect_ratio": ["16:9", "9:16", "4:3", "3:4", "3:2", "2:3", "21:9"]}, "amount": 0.0412, "multiply_by": "num_images"},
      {"tool": "generate_image", "match": {"model": "gpt-image", "quality": "high"}, "amount": 0.0527, "multiply_by": "num_images"},
      {"tool": "generate_image", "match": {"model": "gpt-image", "aspect_ratio": ["16:9", "9:16", "4:3", "3:4", "3:2", "2:3", "21:9"]}, "amount": 0.034, "multiply_by": "num_images"},
      {"tool": "generate_image", "match": {"model": "gpt-image"}, "amount": 0.0435, "multiply_by": "num_images"},
      {"tool": "generate_image", "amount": 0.134, "multiply_by": "num_images"},
      {"tool": "edit_image_ai", "match": {"model": "gpt-image", "quality": "high"}, "amount": 0.0527},
      {"tool": "edit_image_ai", "match": {"model": "gpt-image"}, "amount": 0.0435},
      {"tool": "edit_image_ai", "amount": 0.134}
    ]
  },
  "skills": [
    {
      "id": "image-gen-usage",
      "loading": "always",
      "file": "skills/image-gen.md",
      "description": "Image generation tool descriptions and model selection guidance",
      "default_exclude_from": ["meeting"]
    }
  ],
  "permissions": {
    "default_tier": "standard"
  },
  "patched": false,
  "patch_note": null
}
